[Unit]
Description=hemicycle.data — capture des textes officiels rattaches aux votes finaux
Documentation=https://github.com/pierrebelin/HemicycleData
# La capture utilise directement PostgreSQL, mais les migrations sont jouees au
# demarrage du service principal : il doit donc etre lance auparavant.
Requires=hemicycle.service
After=hemicycle.service

[Service]
Type=oneshot
User=hemicycle
Group=hemicycle
WorkingDirectory=/home/hemicycle/app
EnvironmentFile=-/home/hemicycle/shared/.env
ExecStart=/home/hemicycle/app/deploy/cron/hemicycle-text-capture.sh

# Cinq documents pilotes a 30 s chacun, avec une marge pour PostgreSQL.
TimeoutStartSec=600

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hemicycle-text-capture

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend Rust (Axum)",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--bin", "hemicycle-data"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Frontend React (Vite)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npx vite --port $PORT"],
      "port": 5173,
      "autoPort": true
    }
  ]
}

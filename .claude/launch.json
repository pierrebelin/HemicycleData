{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend Rust (Axum)",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Frontend React (Vite)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npx vite --port 5173"],
      "port": 5173
    }
  ]
}
